# העתק קובץ זה ל-.env ומלא את המפתח שלך מ-https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# אופציונלי
PORT=3000
# תיקיית העבודה שבה הכלים (bash/קבצים) פועלים. ברירת מחדל: התיקייה הנוכחית
WORKDIR=.
# מודל ברירת מחדל
DEFAULT_MODEL=claude-sonnet-4-6

# הגנת סיסמה (HTTP Basic) — חובה לחשיפה ציבורית! הגדר את שניהם כדי להפעיל.
# AUTH_USER=admin
# AUTH_PASS=בחר-סיסמה-חזקה
